# Copy to .env. Never commit real credentials.
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://pricehunter:pricehunter@localhost:5432/pricehunter
# Per-process pool; multiply size + overflow by the number of API/bot/worker replicas.
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800
# asyncpg command timeout for runtime SQL. Alembic uses an independent NullPool.
DATABASE_COMMAND_TIMEOUT_SECONDS=300
RUNTIME_PREFLIGHT_TIMEOUT_SECONDS=5
# Total technical acquisition deadline; lease must be longer. Crash recovery uses expiry.
VALIDATION_TIMEOUT_SECONDS=7200
VALIDATION_LEASE_SECONDS=7500
REDIS_URL=redis://localhost:6379/0
# Override these if another local project already occupies the default ports.
# Keep local DATABASE_URL/REDIS_URL in sync; containers use internal service names.
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
ALLOWED_HOSTS=["localhost","127.0.0.1"]
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
# Production webhook requires a bot token and a random 32..256 character URL-safe secret.
TELEGRAM_WEBHOOK_SECRET=
SUPPORT_CONTACT=@slavasham

# Development only. Prices: 100 -> 95 -> 90 -> 85 EUR, then stable.
MOCK_PROVIDER_ENABLED=true
MOCK_CHECK_INTERVAL_SECONDS=60
EBAY_ENABLED=false
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Production App ID / Cert ID with approved Browse access; see docs/ebay-setup.md.
# First country is the default search market when a user has not selected one.
EBAY_MARKETPLACES=["BE","DE","FR","NL","IT","ES","AT","IE","PL"]
EBAY_BELGIUM_LOCALE=nl-BE
# Optional official EPN campaign (10 digits); returned affiliate URL only.
EBAY_EPN_CAMPAIGN_ID=
# Optional explicitly configured delivery context; omit unless both are known.
# EBAY_DELIVERY_COUNTRY=BE
EBAY_DELIVERY_POSTAL_CODE=

# Required reviewed permissions for EACH real provider. No implicit tracking approval.
# See docs/international-commerce.md. Mock data has an internal synthetic policy.
PROVIDER_DATA_POLICIES={}

RAKUTEN_ENABLED=false
RAKUTEN_CLIENT_ID=
RAKUTEN_CLIENT_SECRET=
RAKUTEN_ACCOUNT_ID=
# Reviewed partner advertiser MIDs per catalog market; no invented network filter.
RAKUTEN_ADVERTISERS={}
RAKUTEN_PAGE_SIZE=20
RAKUTEN_MAX_PAGES=2
RAKUTEN_MAX_RESULTS=50

PUBLIC_BASE_URL=
REDIRECT_SIGNING_SECRET=
REDIRECT_TTL_SECONDS=86400
OUTBOUND_CLICK_RETENTION_DAYS=30
FX_ENABLED=false
FX_REFRESH_SECONDS=21600
FX_MAX_AGE_DAYS=7

# Public WooCommerce Store API, no account or token required. See docs/public-stores.md.
WOOCOMMERCE_STORES=[]
# Per-shop operation limits; resolve may make two HTTP requests for a variant.
PROVIDER_RATE_LIMITS={"woocommerce_pine64_eu":10,"woocommerce_raspberrypi_dk":10,"woocommerce_hemptees_be":5,"woocommerce_westernshop_be":5,"amazon":5,"rakuten":20}

# Creators API requires keys AND separate approval for tracking/history/Telegram alerts.
# Keep disabled pending approval. See docs/amazon-setup.md.
AMAZON_ENABLED=false
AMAZON_PRICE_TRACKING_APPROVED=false
AMAZON_CREDENTIAL_VERSION=3.2
AMAZON_CREATOR_CLIENT_ID=
AMAZON_CREATOR_CLIENT_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACES={}
# Example after approval: {"BE":{"partner_tag":"your-be-tag"},"DE":{"partner_tag":"your-de-tag"}}
# BESTBUY is a future adapter.
BESTBUY_API_KEY=

# Telegram digital subscriptions use Stars only. Enable deliberately after migration.
STARS_BILLING_ENABLED=false
BILLING_PRICE_VERSION=v1
CHECKOUT_TTL_SECONDS=900
# External providers remain disabled in Telegram.
STRIPE_SECRET_KEY=
WALLET_PAY_API_KEY=
PRO_PRICE_STARS=250
POWER_PRICE_STARS=750
FREE_TRACKER_LIMIT=2
PRO_TRACKER_LIMIT=50
POWER_TRACKER_LIMIT=250
FREE_CHECK_SECONDS=43200
PRO_CHECK_SECONDS=7200
POWER_CHECK_SECONDS=3600
# Search requests per 24-hour window, and returned offers per request.
FREE_SEARCH_LIMIT=3
PRO_SEARCH_LIMIT=30
POWER_SEARCH_LIMIT=100
FREE_SEARCH_RESULTS=3
PRO_SEARCH_RESULTS=15
POWER_SEARCH_RESULTS=50
FREE_HISTORY_DAYS=7
PRO_HISTORY_DAYS=90
POWER_HISTORY_DAYS=365
# Capability flags; policies are shared by API, bot and worker.
PLAN_FEATURES={"free":["comparison_search","history_access"],"pro":["target_price_alerts","historical_low_alerts","back_in_stock_alerts","comparison_search","history_access"],"power":["target_price_alerts","historical_low_alerts","back_in_stock_alerts","comparison_search","history_access"]}
USER_REQUESTS_PER_MINUTE=10
PROVIDER_REQUESTS_PER_MINUTE=60
PROVIDER_CONCURRENCY=2
PROVIDER_TIMEOUT_SECONDS=20
MAX_RESPONSE_BYTES=2000000
REFRESH_LEASE_SECONDS=120
BATCH_SIZE=100
NOTIFICATION_COOLDOWN_SECONDS=3600
# 0 preserves history. Pruning is an explicit CLI operation.
HISTORY_RETENTION_DAYS=0

# M3B: exact provider name, then category before '_', then default. Zero disables fresh status.
OFFER_FRESHNESS_SECONDS={"default":86400,"ebay":64800,"woocommerce":86400,"amazon":0,"mock":300}
# Leave Amazon at zero until its approved display/storage policy is configured.
DISCOVERY_ENABLED=true
DISCOVERY_PLAN_SECONDS={"free":604800,"pro":86400,"power":21600}
MOCK_DISCOVERY_SECONDS=600
DISCOVERY_BATCH_SIZE=20
DISCOVERY_RESULT_LIMIT=50
DISCOVERY_LEASE_SECONDS=180
DISCOVERY_FAILURE_THRESHOLD=5
DISCOVERY_SUPPRESSION_SECONDS=3600
COMPARISON_REFRESH_LIMIT=20

# M4B: authorized merchant feeds. Configure reviewed programs before enabling.
AWIN_ENABLED=false
AWIN_FEED_API_KEY=
TRADEDOUBLER_ENABLED=false
TRADEDOUBLER_TOKEN=
FEED_PROGRAM_IDS=[]
FEED_BATCH_SIZE=500
FEED_LEASE_SECONDS=300
FEED_SYNC_SECONDS=21600
FEED_RETENTION_DAYS=7
FEED_MAX_ROWS=1000000
# M4E: independent technical evidence and guarded full-feed publication.
MERCHANT_VALIDATION_MAX_AGE_SECONDS=604800
FEED_MIN_VALID_ROWS=1
FEED_MAX_INVALID_RATIO=0.25
FEED_SHRINK_GUARD_MIN_PREVIOUS_ROWS=1000
FEED_MAX_SHRINK_RATIO=0.50
FEED_MAX_COMPRESSED_BYTES=256000000
FEED_MAX_DECOMPRESSED_BYTES=2000000000
FEED_MAX_RECORD_BYTES=131072
FEED_PAGE_SIZE=500
FEED_MAX_PAGES=2000

# M4C: CJ Product Feed GraphQL; company ID and publisher website PID are separate.
CJ_ENABLED=false
CJ_API_TOKEN=
CJ_COMPANY_ID=
CJ_WEBSITE_ID=
# Application work budgets, independent of plan output limits.
SEARCH_PROVIDER_CANDIDATE_LIMIT=100
SEARCH_PERSISTENCE_LIMIT=200
SEARCH_COMPARISON_LIMIT=100
SEARCH_ERROR_LIMIT=20
